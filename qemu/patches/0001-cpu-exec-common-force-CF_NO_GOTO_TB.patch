--- a/accel/tcg/cpu-exec-common.c	2026-08-20 09:18:27.126671797 -0400
+++ b/accel/tcg/cpu-exec-common.c	2026-08-20 09:18:30.889985670 -0400
@@ -43,7 +43,7 @@
      * Record gdb single-step.  We should be exiting the TB by raising
      * EXCP_DEBUG, but to simplify other tests, disable chaining too.
      *
-     * For singlestep and -d nochain, suppress goto_tb so that
+     * For single-step and -d nochain, suppress goto_tb so that
      * we can log -d cpu,exec after every TB.
      */
     if (unlikely(cpu->singlestep_enabled)) {
@@ -54,6 +54,17 @@
         cflags |= CF_NO_GOTO_TB;
     }
 
+    /*
+     * Open Sober patch (SMC safety): unconditionally disable goto_tb TB
+     * chaining.  Roblox's ARM64 binary self-modifies code pages (canary
+     * patching, JIT regions).  Chained (goto_tb) jumps become stale after
+     * a page is translated once and then rewritten, causing SIGSEGV in the
+     * host.  Forcing CF_NO_GOTO_TB here makes every TB exit through the tb
+     * hash next lookup instead of a direct native jump, so rewritten code
+     * is always re-translated from current guest bytes.
+     */
+    cflags |= CF_NO_GOTO_TB;
+
     return cflags;
 }
 
